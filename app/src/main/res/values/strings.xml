    <string name="globe_next">Tell me how it works</string>
    <string name="globe_title">%1$s, we’ll gather your scattered photos into %2$s</string>
    <string name="globe_title_em">trips</string>
    <string name="globe_hint">Give the globe a tap</string>
    <string name="guide_q_deleted">Do left-out photos get deleted?</string>
    <string name="guide_a_deleted">Nope! I never delete or move a photo unless you choose to. It just stays out of your trips.</string>
    <string name="guide_q_location">How do I save location?</string>
    <string name="guide_a_location">Turn on **location tags** in your camera app settings and I’ll find your trips more accurately.</string>
    <string name="guide_q_video">Do videos work the same way?</string>
    <string name="guide_a_video">Yep, videos work just like photos.</string>
    <string name="guide_line_1">Nice to meet you, %1$s! I’m Tick. I read **when** each photo was taken.</string>
    <string name="guide_line_2">And I’m Pin. I read **where** it was taken. Together, we group your photos into trips.</string>
    <string name="guide_line_3">Before we start, there’s one thing you should know.</string>
    <string name="guide_line_4">Photos and videos usually store the **time taken** and **location** inside them. That’s what we use to find your trips.</string>
    <string name="guide_line_5">So photos and videos without a time or location **might not make it into a trip.**</string>
    <string name="guide_line_6">Here’s an example.</string>
    <string name="guide_title">Tick &amp; Pin</string>
