<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ 시스템 스플래시: 종이색 배경만, 아이콘 없이 → 앱 스플래시 애니메이션이 바로 이어진다 -->
    <style name="Theme.Wend" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
</resources>
